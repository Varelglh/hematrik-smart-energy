# Port untuk backend Express
PORT=3000

# URL YOLO service (FastAPI Python)
YOLO_SERVICE_URL=http://127.0.0.1:8000

# Opsional: kalau port 8000 bentrok, set ini (dipakai oleh npm run start:all)
YOLO_PORT=8000

# Opsional: reload uvicorn (1 untuk dev, 0 untuk stabil)
RELOAD=0

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hematrik
DB_POOL_SIZE=10

# Logika delay mematikan listrik setelah ruangan kosong
DELAY_OFF=7

# Jam kerja (dipakai untuk kondisi NORMAL/PEMBOROSAN/PERINGATAN/AMAN)
WORK_HOURS_START=8
WORK_HOURS_END=17

# Default status perangkat (dummy IoT)
DEFAULT_LAMPU=ON
DEFAULT_AC=ON
DEFAULT_DISPENSER=OFF

# Sistem otomatis: jalankan /check tiap interval
AUTO_CHECK_ENABLED=0
AUTO_CHECK_INTERVAL_SECONDS=60
